# ─────────────────────────────────────────────────────────
# VCE-HQ Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Google AI API key (for Gemini LLM + text-embedding-005)
GOOGLE_API_KEY=your-google-api-key-here

# LLM model for agent reasoning (Router, OS, Cloud, Security)
VCE_LLM_MODEL=gemini-2.0-flash

# Embedding model
VCE_EMBEDDING_MODEL=text-embedding-005
VCE_EMBEDDING_DIMENSIONS=768

# Data directory (per-tenant databases stored here)
VCE_DATA_DIR=./data

# Server
VCE_HOST=0.0.0.0
VCE_PORT=8000

# Logging
VCE_LOG_LEVEL=INFO
VCE_LOG_FORMAT=json

# Credential hashing secret (used to derive per-tenant encryption keys)
VCE_CREDENTIAL_SECRET=change-this-to-a-strong-random-secret
