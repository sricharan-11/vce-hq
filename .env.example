# ─────────────────────────────────────────────────────────
# VCE-HQ Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────
# LLM Providers (Pick One)
# ─────────────────────────────────────────────────────────
# Set this to "google_genai", "openai", "anthropic", "deepseek", or "qwen"
VCE_LLM_PROVIDER=google_genai
VCE_LLM_MODEL=gemini-3.1-pro

# Set this to "google_genai" or "openai"
VCE_EMBEDDING_PROVIDER=google_genai
VCE_EMBEDDING_MODEL=text-embedding-005
VCE_EMBEDDING_DIMENSIONS=768

# ─────────────────────────────────────────────────────────
# API Keys (Provide keys for your chosen providers)
# ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
QWEN_API_KEY=your-qwen-api-key-here

# Data directory (per-tenant databases stored here)
VCE_DATA_DIR=./data

# Server
VCE_HOST=0.0.0.0
VCE_PORT=8000

# Logging
VCE_LOG_LEVEL=INFO
VCE_LOG_FORMAT=json

# Credential hashing secret (used to derive per-tenant encryption keys)
VCE_CREDENTIAL_SECRET=change-this-to-a-strong-random-secret
