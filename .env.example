# ═══════════════════════════════════════════════════════════════════════════
#  VCE-HQ Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#  1. Copy this file:            cp .env.example .env
#  2. Fill in at least one LLM provider API key below.
#  3. Rotate every "change-me-*" secret before running in production.
#  4. Start:                     docker compose up -d
#
#  All VCE_* variables map 1:1 onto pydantic Settings in src/vce_hq/config.py.
#  Anything left blank falls back to the default in that module.
# ═══════════════════════════════════════════════════════════════════════════


# ─── LLM Provider Selection ────────────────────────────────────────────────
# Options: google_genai | openai | anthropic | deepseek | qwen
VCE_LLM_PROVIDER=google_genai
VCE_LLM_MODEL=gemini-3.1-pro

# ─── Provider API Keys ─────────────────────────────────────────────────────
# Only the key for VCE_LLM_PROVIDER (and VCE_EMBEDDING_PROVIDER) is required.
# Both prefixed (VCE_*) and unprefixed forms are accepted.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Custom endpoint for any OpenAI-compatible provider (self-hosted, proxies, etc.)
OPENAI_API_BASE=

# ─── Per-Agent LLM Overrides (optional) ────────────────────────────────────
# Leave blank to inherit VCE_LLM_PROVIDER / VCE_LLM_MODEL above.
# Handy for mixing frontier + small models across the swarm.
VCE_INTENT_ANALYZER_LLM_PROVIDER=
VCE_INTENT_ANALYZER_LLM_MODEL=
VCE_ROUTER_LLM_PROVIDER=
VCE_ROUTER_LLM_MODEL=
VCE_OS_ENGINEER_LLM_PROVIDER=
VCE_OS_ENGINEER_LLM_MODEL=
VCE_CLOUD_ENGINEER_LLM_PROVIDER=
VCE_CLOUD_ENGINEER_LLM_MODEL=
VCE_FINOPS_AGENT_LLM_PROVIDER=
VCE_FINOPS_AGENT_LLM_MODEL=
# Security Gate: prefer a *different* provider than the generators (heterogeneous gating).
VCE_SECURITY_REVIEW_LLM_PROVIDER=
VCE_SECURITY_REVIEW_LLM_MODEL=

# ─── Embeddings ────────────────────────────────────────────────────────────
# Options: google_genai | openai
# IMPORTANT: changing dimensions requires wiping ./data (vector table is fixed-width).
VCE_EMBEDDING_PROVIDER=google_genai
VCE_EMBEDDING_MODEL=text-embedding-005
VCE_EMBEDDING_DIMENSIONS=768

# ─── Server ────────────────────────────────────────────────────────────────
# Inside the container the app always listens on VCE_PORT.
# VCE_HOST_PORT is only read by docker-compose to publish it on the host.
VCE_HOST=0.0.0.0
VCE_PORT=8000
VCE_HOST_PORT=8000

# ─── Storage ───────────────────────────────────────────────────────────────
# In Docker this points inside the container; the compose file mounts a
# named volume at this path so data survives container rebuilds.
VCE_DATA_DIR=./data

# ─── Logging ───────────────────────────────────────────────────────────────
# VCE_LOG_LEVEL:  DEBUG | INFO | WARNING | ERROR | CRITICAL
# VCE_LOG_FORMAT: json | console
VCE_LOG_LEVEL=INFO
VCE_LOG_FORMAT=json

# ─── Authentication & Secrets (rotate before production!) ──────────────────
# Generate strong values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
VCE_CREDENTIAL_SECRET=change-me-credential-secret
VCE_JWT_SECRET_KEY=change-me-jwt-secret
VCE_JWT_EXPIRATION_MINUTES=1440
# Seeded on first migration for the default 'admin' user. Change immediately.
VCE_ADMIN_PASSWORD=change-me-admin-password
# Set to false for local dev over http, true for production behind HTTPS
VCE_COOKIE_SECURE=true

# ─── GCP OAuth 2.0 / IAM-Derived Roles (PRD §7.2) ──────────────────────────
# When enabled, users can sign in with Google and their VCE role is derived
# from the tenant project's IAM policy. Requires a service account with
# resourcemanager.projects.getIamPolicy (roles/iam.securityReviewer or higher)
# stored in The Vault under the name in VCE_GCP_IAM_CREDENTIAL_NAME.
VCE_GCP_AUTH_ENABLED=false
VCE_GCP_OAUTH_CLIENT_ID=
VCE_GCP_OAUTH_CLIENT_SECRET=
VCE_GCP_OAUTH_REDIRECT_URI=http://localhost:8000/auth/gcp/callback
# The GCP project whose IAM policy is authoritative for role resolution (M1).
VCE_GCP_PROJECT_ID=
# Vault credential name holding the SA JSON used for IAM lookups.
VCE_GCP_IAM_CREDENTIAL_NAME=gcp-iam-lookup
# Comma-separated Workspace hosted domains (empty = any Google account).
VCE_GCP_ALLOWED_DOMAINS=
# GCP roles mapped to VCE 'admin' (comma-separated).
VCE_GCP_ROLE_MAP_ADMIN=roles/owner,roles/resourcemanager.projectIamAdmin,roles/vce.admin
# GCP roles mapped to VCE 'user' (comma-separated).
VCE_GCP_ROLE_MAP_USER=roles/editor,roles/viewer,roles/vce.user
# Minutes between background re-checks of a signed-in user's IAM roles.
VCE_GCP_ROLE_SYNC_TTL_MINUTES=15

# ─── Microsoft Entra ID OIDC / Azure RBAC-Derived Roles (PRD §7.2.2) ───────
# When enabled, users can sign in with Microsoft and their VCE role is derived
# from Azure RBAC role assignments on VCE_AZURE_SUBSCRIPTION_ID. Requires a
# service principal with 'Microsoft.Authorization/roleAssignments/read' on
# the subscription (built-in role: Reader). The SP secret is stored in The
# Vault under the name in VCE_AZURE_IAM_CREDENTIAL_NAME as JSON:
#   {"tenant_id": "...", "client_id": "...", "client_secret": "..."}
VCE_AZURE_AUTH_ENABLED=false
VCE_AZURE_TENANT_ID=
VCE_AZURE_OAUTH_CLIENT_ID=
VCE_AZURE_OAUTH_CLIENT_SECRET=
VCE_AZURE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/azure/callback
# The subscription whose RBAC is authoritative for role resolution (M1).
VCE_AZURE_SUBSCRIPTION_ID=
# Vault credential name holding the SP JSON used for RBAC lookups.
VCE_AZURE_IAM_CREDENTIAL_NAME=azure-iam-lookup
# Comma-separated UPN domains (empty = any user in the tenant).
VCE_AZURE_ALLOWED_DOMAINS=
# Azure role names mapped to VCE 'admin' (comma-separated).
VCE_AZURE_ROLE_MAP_ADMIN=Owner,User Access Administrator,VCE Admin
# Azure role names mapped to VCE 'user' (comma-separated).
VCE_AZURE_ROLE_MAP_USER=Contributor,Reader,VCE User
VCE_AZURE_ROLE_SYNC_TTL_MINUTES=15

# ─── AWS IAM Identity Center OIDC / IAM Policy-Derived Roles (PRD §7.2.3) ──
# When enabled, users can sign in with AWS IAM Identity Center and their VCE
# role is derived from the IAM policies attached to the IAM user whose
# UserName equals the OIDC email OR whose 'Email' tag equals the email.
# Requires an IAM principal with iam:ListUsers, iam:ListAttachedUserPolicies,
# iam:ListUserPolicies, iam:ListGroupsForUser (AWSSecurityAudit covers all).
# The access keys are stored in The Vault under VCE_AWS_IAM_CREDENTIAL_NAME
# as JSON:
#   {"aws_access_key_id": "...", "aws_secret_access_key": "...", "region": "us-east-1"}
VCE_AWS_AUTH_ENABLED=false
# IAM Identity Center OIDC issuer URL (see Identity Center console → Settings).
VCE_AWS_OIDC_ISSUER=
VCE_AWS_OAUTH_CLIENT_ID=
VCE_AWS_OAUTH_CLIENT_SECRET=
VCE_AWS_OAUTH_REDIRECT_URI=http://localhost:8000/auth/aws/callback
VCE_AWS_IAM_CREDENTIAL_NAME=aws-iam-lookup
# Comma-separated email domains (empty = any email accepted by the IdP).
VCE_AWS_ALLOWED_DOMAINS=
# AWS IAM policy names mapped to VCE 'admin' (comma-separated).
VCE_AWS_ROLE_MAP_ADMIN=AdministratorAccess,VCEAdmin
# AWS IAM policy names mapped to VCE 'user' (comma-separated).
VCE_AWS_ROLE_MAP_USER=ReadOnlyAccess,ViewOnlyAccess,VCEUser
VCE_AWS_ROLE_SYNC_TTL_MINUTES=15

# ─── Command Execution Guardrails (The Hands) ──────────────────────────────
# Global kill-switch for any command executor call.
VCE_CMD_ENABLED=true
VCE_CMD_MAX_ITERATIONS=5
VCE_CMD_MAX_PER_SESSION=15
VCE_CMD_TIMEOUT_SECONDS=30
VCE_CMD_MAX_STDOUT_BYTES=65536
VCE_CMD_MAX_STDERR_BYTES=16384
# Risk level assigned to binaries not in the known-safe allowlist.
# Options: NONE | LOW | ELEVATED | HIGH
VCE_UNKNOWN_BINARY_RISK=ELEVATED

# ─── Orchestration ─────────────────────────────────────────────────────────
VCE_ROUTER_MAX_ITERATIONS=3
# Phased execution: mode_1 (read-only) | mode_2 (read+edit) | mode_3 (full)
VCE_EXECUTION_MODE=mode_1
